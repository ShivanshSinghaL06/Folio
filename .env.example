# Copy to .env and fill in. Never commit .env.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Leave the key fields empty to use the ambient AWS credential chain
# (instance role, AWS SSO profile already exported, and so on).

BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_CHAT_MODEL=us.anthropic.claude-sonnet-4-6

# Optional. When empty, retrieved chunks are reranked locally.
# Set a Bedrock rerank model id, such as cohere.rerank-v3-5:0, to rerank in Bedrock.
BEDROCK_RERANK_MODEL=

# Native API (outside Docker). Docker Compose overrides this for the api service.
DATABASE_URL=postgresql+psycopg://search:search@localhost:5432/search

CORS_ORIGINS=http://localhost:5173
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_CANDIDATES=20
RERANK_TOP_K=6
RRF_K=60
MAX_UPLOAD_BYTES=15728640
MAX_QUERY_CHARS=4000
CHAT_HISTORY_MESSAGES=6
